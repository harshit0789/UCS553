import java.util.*;


abstract class FoodOrder {

    private int orderId;
    private String customerName;
    private double amount;

    protected static String restaurantName="Food Palace";

    private static int orderCount=0;


    public FoodOrder(int orderId,String customerName,double amount){

        this.orderId=orderId;
        this.customerName=customerName;
        this.amount=amount;

        orderCount++;

    }


    public int getOrderId(){
        return orderId;
    }


    public String getCustomerName(){
        return customerName;
    }


    public double getAmount(){
        return amount;
    }


    public abstract double calculateDeliveryCharge();



    public static void displayTotalOrders(){

        System.out.println("Total Orders Created : "+orderCount);

    }



    public void displayBill(){

        System.out.println("\n----- ORDER BILL -----");

        System.out.println("Restaurant : "+restaurantName);

        System.out.println("Order ID : "+orderId);

        System.out.println("Customer Name : "+customerName);

        System.out.println("Food Amount : Rs."+amount);

    }


}



interface Discountable{

    double applyDiscount();

}



class RegularOrder extends FoodOrder implements Discountable{


    public RegularOrder(int id,String name,double amount){

        super(id,name,amount);

    }



    public double calculateDeliveryCharge(){

        return 80;

    }



    public double applyDiscount(){

        return getAmount()*0.10;

    }



    public void display(){

        displayBill();

        System.out.println("Discount : Rs."+applyDiscount());

        System.out.println("Delivery Charge : Rs."
        +calculateDeliveryCharge());


        double finalAmount=
        getAmount()-applyDiscount()+calculateDeliveryCharge();


        System.out.println("Final Amount : Rs."+finalAmount);

    }


}



class PremiumOrder extends FoodOrder implements Discountable{


    public PremiumOrder(int id,String name,double amount){

        super(id,name,amount);

    }



    public double calculateDeliveryCharge(){

        return 50;

    }



    public double applyDiscount(){

        return getAmount()*0.15;

    }



    public void display(){

        displayBill();

        System.out.println("Discount : Rs."+applyDiscount());


        System.out.println("Delivery Charge : Rs."
        +calculateDeliveryCharge());


        double finalAmount=
        getAmount()-applyDiscount()+calculateDeliveryCharge();


        System.out.println("Final Amount : Rs."+finalAmount);

    }


}




class OrderUtility{


    public static boolean validateAmount(double amount){

        return amount>0;

    }



    public static boolean validateCustomer(String name){

        return name!=null && !name.isEmpty();

    }


}



public class Main{


    public static void main(String args[]){


        FoodOrder orders[]=new FoodOrder[6];


        orders[0]=new RegularOrder(101,"Harshit",500);

        orders[1]=new PremiumOrder(102,"Rahul",1000);

        orders[2]=new RegularOrder(103,"Aman",700);

        orders[3]=new PremiumOrder(104,"Rohan",1200);

        orders[4]=new RegularOrder(105,"Karan",600);

        orders[5]=new PremiumOrder(106,"Vivek",900);



        for(FoodOrder order:orders){


            if(OrderUtility.validateAmount(order.getAmount())
            &&
            OrderUtility.validateCustomer(order.getCustomerName())){


                if(order instanceof RegularOrder){

                    ((RegularOrder)order).display();

                }

                else if(order instanceof PremiumOrder){

                    ((PremiumOrder)order).display();

                }

            }


            System.out.println("----------------");


        }



        FoodOrder.displayTotalOrders();


    }

}
